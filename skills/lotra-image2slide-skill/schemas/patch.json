{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "base_scene_revision",
    "base_scene_hash",
    "expected_versions",
    "operations"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "base_scene_revision": {
      "type": "integer",
      "minimum": 0
    },
    "base_scene_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "content",
          "structure",
          "style",
          "placement"
        ],
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "field",
          "value"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "field": {
            "enum": [
              "content",
              "parent",
              "semantic_type",
              "render_type",
              "style",
              "bbox",
              "z_order",
              "component"
            ]
          },
          "value": {}
        }
      }
    },
    "dependency_mode": {
      "const": "field_spatial_v1"
    },
    "dependency_signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference_hashes": {
      "type": "object"
    },
    "expected_facets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}
