{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "object_ids",
    "allowed_fields",
    "role"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "object_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "content",
          "parent",
          "semantic_type",
          "render_type",
          "style",
          "bbox",
          "z_order",
          "component"
        ]
      }
    },
    "role": {
      "enum": [
        "icon_worker",
        "formula_worker",
        "geometry_worker",
        "global_layout"
      ]
    },
    "max_translation_px": {
      "type": "number",
      "minimum": 0
    },
    "allow_uniform_scale": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
