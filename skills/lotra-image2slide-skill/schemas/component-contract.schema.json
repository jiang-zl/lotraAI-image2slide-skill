{
  "$defs": {
    "resource": {
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow_version": {
            "enum": [
              "1.34.0",
              "1.35.0"
            ]
          }
        },
        "required": [
          "workflow_version"
        ]
      },
      "then": {
        "required": [
          "source_observation",
          "feature_bindings"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "workflow_version": {
            "const": "1.35.0"
          }
        },
        "required": [
          "workflow_version"
        ]
      },
      "then": {
        "required": [
          "spatial",
          "spatial_bindings",
          "spatial_basis",
          "spatial_units"
        ]
      }
    }
  ],
  "properties": {
    "components": {
      "items": {
        "properties": {
          "frozen_parameters": {
            "type": "boolean"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "implementation_dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "metrics": {
            "items": {
              "properties": {
                "applicable": {
                  "type": "boolean"
                },
                "direction": {
                  "enum": [
                    "lower",
                    "higher",
                    "exact"
                  ]
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "measurement": {
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "adapter": {
                            "const": "keypoint_distance"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "keypoints"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "adapter": {
                            "const": "line_width_error"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "width_estimator"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "adapter": {
                      "enum": [
                        "keypoint_distance",
                        "endpoint_distance",
                        "centerline_distance",
                        "curve_distance",
                        "line_width_error"
                      ]
                    },
                    "coordinate_space": {
                      "const": "component_roi"
                    },
                    "expected_count": {
                      "maximum": 4096,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "foreground": {
                      "type": "object"
                    },
                    "keypoints": {
                      "items": {
                        "properties": {
                          "id": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "kind": {
                            "enum": [
                              "corner",
                              "intersection",
                              "endpoint"
                            ]
                          },
                          "min_distance": {
                            "maximum": 16,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "sigma": {
                            "exclusiveMinimum": 0,
                            "maximum": 3,
                            "type": "number"
                          },
                          "source_point": {
                            "items": {
                              "type": "number"
                            },
                            "maxItems": 2,
                            "minItems": 2,
                            "type": "array"
                          },
                          "threshold_rel": {
                            "exclusiveMinimum": 0,
                            "maximum": 1,
                            "type": "number"
                          },
                          "window": {
                            "items": {
                              "type": "number"
                            },
                            "maxItems": 4,
                            "minItems": 4,
                            "type": "array"
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "source_point",
                          "window"
                        ],
                        "type": "object"
                      },
                      "maxItems": 64,
                      "minItems": 1,
                      "type": "array"
                    },
                    "source_evidence": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "source_points": {
                      "items": {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                      },
                      "type": "array"
                    },
                    "source_width": {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    "statistic": {
                      "enum": [
                        "mean",
                        "p95",
                        "max"
                      ]
                    },
                    "width_estimator": {
                      "const": "pixel_cell_normal_chord"
                    },
                    "window": {
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 4,
                      "minItems": 4,
                      "type": "array"
                    }
                  },
                  "required": [
                    "adapter",
                    "coordinate_space",
                    "window",
                    "foreground",
                    "source_evidence"
                  ],
                  "type": "object"
                },
                "measurement_domain": {
                  "enum": [
                    "analytic",
                    "raster"
                  ]
                },
                "normalization_scale": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "enum": [
                    "target",
                    "diagnostic",
                    "trigger",
                    "stagnation"
                  ]
                },
                "sampling_scale": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "source_fact_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "threshold": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role",
                "direction"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "model": {
            "properties": {
              "id": {
                "type": "string"
              },
              "source_adapter": {
                "enum": [
                  "primitive_source_fit",
                  "source_preset_fit",
                  "source_detail_fit",
                  "source_fit",
                  "source_feature_functions",
                  "semantic_curves"
                ]
              },
              "version": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          },
          "mother": {
            "type": "string"
          },
          "owners": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "parameter_metric_map": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "type": "object"
          },
          "parameters": {
            "additionalProperties": {
              "properties": {
                "bounds": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                "minimum_step": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "state": {
                  "enum": [
                    "fixed",
                    "tunable"
                  ]
                }
              },
              "required": [
                "state",
                "value"
              ],
              "type": "object"
            },
            "type": "object"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "roi": {
            "items": {
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "route": {
            "enum": [
              "fixed_parameters",
              "local_fit",
              "assembly",
              "instance",
              "specialist"
            ]
          },
          "scale_policy": {
            "enum": [
              "scale_with_geometry",
              "preserve_absolute_style"
            ]
          },
          "source_evidence": {
            "minLength": 1,
            "type": "string"
          },
          "source_facts": {
            "items": {
              "properties": {
                "evidence": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "interval": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "unit",
                "evidence"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "source_refs": {
            "items": {
              "$ref": "#/$defs/resource"
            },
            "minItems": 1,
            "type": "array"
          },
          "source_units": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "spatial_instance": {
            "properties": {
              "construction_ids": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "constructor_map": {
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 1,
                "type": "object"
              },
              "route": {
                "enum": [
                  "native_affine_copy",
                  "reproject_constructor"
                ]
              },
              "source_evidence": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "route",
              "source_evidence"
            ],
            "type": "object"
          },
          "support_mask": {
            "$ref": "#/$defs/resource"
          },
          "transform_policy": {
            "properties": {
              "allow_non_uniform": {
                "type": "boolean"
              },
              "allow_reflection": {
                "type": "boolean"
              },
              "source_evidence": {
                "type": "string"
              },
              "style_scale": {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "unresolved_dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "variant": {
            "properties": {
              "id": {
                "type": "string"
              },
              "mother": {
                "type": "string"
              },
              "overrides": {
                "items": {
                  "properties": {
                    "field": {
                      "items": {
                        "type": [
                          "string",
                          "integer"
                        ]
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "owner": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "owner",
                    "field",
                    "value"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "source_evidence": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "mother",
              "source_evidence",
              "overrides"
            ],
            "type": "object"
          },
          "visual_review_required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "route",
          "owners",
          "source_units",
          "source_evidence",
          "source_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "design_revision": {
      "const": 8
    },
    "feature_bindings": {
      "items": {
        "properties": {
          "component": {
            "minLength": 1,
            "type": "string"
          },
          "feature": {
            "minLength": 1,
            "type": "string"
          },
          "owners": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "representation": {
            "properties": {
              "family": {
                "enum": [
                  "native_text",
                  "native_math",
                  "native_connector",
                  "preset",
                  "native_composite",
                  "native_surface",
                  "native_path",
                  "native_cubic",
                  "raster_exception"
                ]
              },
              "table_cell": {
                "items": {
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "family"
            ],
            "type": "object"
          }
        },
        "required": [
          "feature",
          "component",
          "owners",
          "representation"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "native_constructions": {
      "items": {
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "annular_sector",
              "band",
              "ellipse_stack",
              "elliptic_solid",
              "extruded_contour",
              "planar_detail",
              "prism",
              "spatial_polyhedron",
              "spatial_prism"
            ]
          },
          "source_evidence": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "source_evidence"
        ],
        "type": "object"
      },
      "maxItems": 512,
      "type": "array"
    },
    "nonpaint_owners": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "relations": {
      "items": {
        "properties": {
          "components": {
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "contains",
              "contact",
              "gap",
              "align_x",
              "align_y",
              "layer_before",
              "connects",
              "label_for",
              "instance_of",
              "intentional_overlap"
            ]
          },
          "measurement": {
            "enum": [
              "native_frame",
              "painted"
            ]
          },
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source_evidence": {
            "minLength": 1,
            "type": "string"
          },
          "tolerance_source_px": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "kind",
          "components",
          "source_evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "component-protocol-1.32.0"
    },
    "scope": {
      "properties": {
        "excluded_checks": {
          "items": {
            "enum": [
              "office_open",
              "office_edit",
              "office_save_reopen"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_inventory": {
      "items": {
        "properties": {
          "excluded_reason": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "source_evidence": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_evidence"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_observation": {
      "$ref": "#/$defs/resource"
    },
    "spatial": {
      "properties": {
        "frames": {
          "maxItems": 2048,
          "minItems": 1,
          "type": "array"
        },
        "landmarks": {
          "maxItems": 50000,
          "type": "array"
        },
        "relations": {
          "maxItems": 20000,
          "type": "array"
        },
        "schema": {
          "const": "spatial-1.35.0"
        }
      },
      "required": [
        "schema",
        "frames",
        "landmarks",
        "relations"
      ],
      "type": "object"
    },
    "spatial_bindings": {
      "items": {
        "properties": {
          "anchor": {
            "properties": {
              "kind": {
                "enum": [
                  "frame_point",
                  "path_point"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "landmark": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "source_evidence": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "landmark",
          "owner",
          "anchor",
          "source_evidence"
        ],
        "type": "object"
      },
      "maxItems": 50000,
      "type": "array"
    },
    "workflow_version": {
      "enum": [
        "1.33.0",
        "1.34.0",
        "1.35.0"
      ]
    }
  },
  "required": [
    "schema",
    "source_hash",
    "source_inventory",
    "components",
    "relations",
    "scope",
    "design_revision"
  ],
  "type": "object"
}
